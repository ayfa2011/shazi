{
  "rules": {
    "couples": {
      "$coupleId": {
        ".read": "auth != null && (auth.token.email === 'akabeeram@gmail.com' || auth.token.email === 'hizasgallery@gmail.com')",
        ".write": "auth != null && (auth.token.email === 'akabeeram@gmail.com' || auth.token.email === 'hizasgallery@gmail.com')",
        "partnerChat": {
          "messages": {
            ".indexOn": ["createdAt"]
          }
        }
      }
    },
    "battleshipMatches": {
      "$matchId": {
        ".read": "auth != null && (auth.token.email === 'akabeeram@gmail.com' || auth.token.email === 'hizasgallery@gmail.com')",
        ".write": false
      }
    },
    "battleshipPrivate": {
      "$matchId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && (auth.token.email === 'akabeeram@gmail.com' || auth.token.email === 'hizasgallery@gmail.com')",
          ".write": false
        }
      }
    }
  }
}

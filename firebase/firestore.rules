rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoupleMember() {
      return request.auth != null && request.auth.token.email in [
        'akabeeram@gmail.com',
        'hizasgallery@gmail.com'
      ];
    }

    function isOwnAuthorId(authorId) {
      return authorId == request.auth.uid
        || (request.auth.token.email == 'akabeeram@gmail.com' && authorId == 'profile-one')
        || (request.auth.token.email == 'hizasgallery@gmail.com' && authorId == 'profile-two');
    }

    function ownNotificationProfileKey() {
      return request.auth.token.email == 'akabeeram@gmail.com' ? 'kebyy' : 'shazy';
    }

    function isLetterRecipient(data) {
      return data.get('recipient', '') == ownNotificationProfileKey()
        || (ownNotificationProfileKey() == 'kebyy' && data.get('recipient', '') == 'Keby')
        || (ownNotificationProfileKey() == 'shazy' && data.get('recipient', '') == 'Shazy');
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['recipientKey', 'actorKey', 'type', 'title', 'message', 'route', 'sourceId', 'createdAt', 'readAt'])
        && data.keys().hasOnly(['recipientKey', 'actorKey', 'type', 'title', 'message', 'route', 'sourceId', 'createdAt', 'readAt'])
        && data.actorKey == ownNotificationProfileKey()
        && data.recipientKey in ['kebyy', 'shazy']
        && data.recipientKey != data.actorKey
        && data.type in ['question', 'challenge', 'letter', 'memory', 'drawing', 'post', 'comment', 'like', 'bucket', 'customQuestion', 'specialDay', 'game', 'music']
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 240
        && ((data.type == 'question' && data.route == 'questions')
          || (data.type == 'challenge' && data.route == 'challenges')
          || (data.type == 'letter' && data.route == 'letters')
          || (data.type == 'memory' && data.route == 'memories')
          || (data.type == 'drawing' && data.route == 'drawing')
          || (data.type == 'post' && data.route == 'gallery')
          || (data.type == 'comment' && data.route == 'gallery')
          || (data.type == 'like' && data.route == 'gallery')
          || (data.type == 'bucket' && data.route == 'bucket')
          || (data.type == 'customQuestion' && data.route == 'questions')
          || (data.type == 'specialDay' && data.route == 'more')
          || (data.type == 'game' && data.route == 'games')
          || (data.type == 'music' && data.route == 'home'))
        && data.sourceId is string
        && data.sourceId.size() > 0
        && data.sourceId.size() <= 100
        && data.sourceId.matches('^[A-Za-z0-9_-]+$')
        && notificationId.matches('^(question|challenge|letter|memory|drawing|post|comment|like|bucket|customQuestion|specialDay|game|music)-[A-Za-z0-9_-]+-(kebyy|shazy)$')
        && data.createdAt == request.time
        && data.readAt == null;
    }

    function isValidSpecialDay(data) {
      return data.keys().hasAll(['type', 'author', 'title', 'category', 'date', 'recurring', 'createdAt'])
        && data.keys().hasOnly(['type', 'author', 'title', 'category', 'date', 'recurring', 'createdAt', 'updatedAt'])
        && data.type == 'specialDay'
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.category in ['Birthday', 'Anniversary', 'Celebration', 'Other']
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.recurring is bool
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    function ownsAuthoredFields(data) {
      return data.get('author', request.auth.uid) == request.auth.uid
        && isOwnAuthorId(data.get('authorId', request.auth.uid));
    }

    function isCustomChallengeCreate(data) {
      return ownsAuthoredFields(data)
        && data.get('authorKey', '') == ownNotificationProfileKey()
        && data.get('recipientKey', '') in ['kebyy', 'shazy']
        && data.get('recipientKey', '') != ownNotificationProfileKey()
        && data.get('status', '') == 'upcoming';
    }

    function ownsDiaryPost(collectionName, data) {
      return collectionName != 'diaryPosts'
        || (data.keys().hasAll(['authorId']) && isOwnAuthorId(data.authorId));
    }

    function isOwnLetterRecipient(recipient) {
      return (request.auth.token.email == 'akabeeram@gmail.com' && recipient == 'kebyy')
        || (request.auth.token.email == 'hizasgallery@gmail.com' && recipient == 'shazy');
    }

    function isLegacyScheduledLetterBodyMigration() {
      return resource.data.get('type', '') == 'letter'
        && resource.data.get('status', '') == 'Scheduled'
        && resource.data.keys().hasAny(['body'])
        && resource.data.get('author', '') != request.auth.uid
        && isOwnLetterRecipient(resource.data.get('recipient', ''))
        && !request.resource.data.keys().hasAny(['body'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body']);
    }

    function canCommentOnPost(postId) {
      return exists(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId))
        && !get(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId)).data.get('deleting', false);
    }

    function diaryPostExists(postId) {
      return exists(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId));
    }

    function diaryPostIsDeleting(postId) {
      let post = get(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId)).data;
      return post.get('deleting', false) && isOwnAuthorId(post.get('authorId', ''));
    }

    match /couples/{coupleId}/{collectionName}/{documentId} {
      // Allow a signed-in partner to read their own daily water tracker,
      // including when the document does not exist yet (first glass of the day).
      allow get: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName == 'items'
        && documentId.matches('^water-[0-9]{4}-[0-9]{2}-[0-9]{2}-(kebyy|shazy)$')
        && documentId.matches('^water-[0-9]{4}-[0-9]{2}-[0-9]{2}-' + ownNotificationProfileKey() + '$');

      allow read: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'notifications'
        && collectionName != 'scheduledLetterContents'
        && (
          (collectionName == 'items' && resource.data.get('type', '') == 'customChallenge')
          || resource.data.get('type', '') != 'answer'
          || resource.data.get('author', '') == request.auth.uid
        );
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'notifications'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && request.resource.data.get('type', '') != 'answer'
        && (request.resource.data.get('type', '') == 'customChallenge'
          ? (collectionName == 'items' && isCustomChallengeCreate(request.resource.data))
          : ownsAuthoredFields(request.resource.data))
        && (request.resource.data.get('type', '') != 'specialDay'
          || (collectionName == 'items' && isValidSpecialDay(request.resource.data)))
        && (request.resource.data.get('type', '') == 'customChallenge'
          || ownsDiaryPost(collectionName, request.resource.data));
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'notifications'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && resource.data.get('type', '') != 'answer'
        && (
          (collectionName == 'items'
            && resource.data.get('type', '') == 'letter'
            && resource.data.get('author', '') != request.auth.uid
            && isLetterRecipient(resource.data)
            && resource.data.get('readAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
            && request.resource.data.readAt == request.time)
          ||
          (collectionName == 'items'
            && resource.data.get('type', '') == 'memory'
            && isCoupleMember())
          ||
          (collectionName == 'items'
            && resource.data.get('type', '') != 'customChallenge'
            && resource.data.get('type', '') != 'memory'
            && ownsAuthoredFields(resource.data)
            && (!request.resource.data.keys().hasAny(['author', 'authorId']) || ownsAuthoredFields(request.resource.data))
            && ownsDiaryPost(collectionName, request.resource.data))
          || (collectionName == 'items'
            && resource.data.get('type', '') == 'specialDay'
            && isValidSpecialDay(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'date', 'recurring', 'updatedAt']))
          || (collectionName == 'items' && isLegacyScheduledLetterBodyMigration())
          || (collectionName == 'items' && resource.data.get('type', '') == 'customChallenge'
            && ((resource.data.get('author', '') == request.auth.uid
                && resource.data.get('status', '') in ['upcoming', 'in-progress']
                && request.resource.data.get('status', '') == resource.data.get('status', '')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'updatedAtMs']))
              || (resource.data.get('recipientKey', '') == ownNotificationProfileKey()
                && request.resource.data.get('author', '') == resource.data.get('author', '')
                && request.resource.data.get('recipientKey', '') == resource.data.get('recipientKey', '')
                && request.resource.data.get('status', '') in ['in-progress', 'completed']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actions', 'acceptedBy', 'acceptedAtMs', 'note', 'photoUrl', 'completedBy', 'completedByKey', 'completedAtMs'])
                && ((request.resource.data.status == 'in-progress' && resource.data.status in ['upcoming', 'in-progress'])
                  || (request.resource.data.status == 'completed' && resource.data.status == 'in-progress')))))
        );
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'notifications'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && resource.data.get('type', '') != 'answer'
        && (
          ((collectionName == 'items'
              && resource.data.get('type', '') in ['memory', 'music']
              && isCoupleMember())
            || (collectionName == 'items'
              && resource.data.get('type', '') != 'customChallenge'
              && resource.data.get('type', '') != 'memory'
              && resource.data.get('type', '') != 'music'
              && ownsAuthoredFields(resource.data)
              && ownsDiaryPost(collectionName, resource.data)))
          || (collectionName == 'items' && resource.data.get('type', '') == 'specialDay')
          || (collectionName == 'items' && resource.data.get('type', '') == 'customChallenge'
            && resource.data.get('author', '') == request.auth.uid
            && resource.data.get('status', '') != 'completed')
          || collectionName == 'drawingMessages'
        );
    }

    match /couples/{coupleId}/diaryPosts/{postId} {
      allow read: if isCoupleMember() && coupleId == 'our-little-world';
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && isOwnAuthorId(resource.data.get('authorId', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.get('text', '') is string
        && request.resource.data.text.size() <= 5000;
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && !resource.data.get('deleting', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && resource.data.get('likedBy', []) is list
        && request.resource.data.get('likedBy', []) is list
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.likedBy.toSet().hasAny([request.auth.uid])
          != request.resource.data.likedBy.toSet().hasAny([request.auth.uid]);
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && isOwnAuthorId(resource.data.get('authorId', ''))
        && !resource.data.get('deleting', false)
        && request.resource.data.get('deleting', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting']);
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && isOwnAuthorId(resource.data.get('authorId', ''))
        && resource.data.get('deleting', false) == true;
    }

    match /couples/{coupleId}/scheduledLetterContents/{letterId} {
      function isValidContentCreate() {
        let data = request.resource.data;
        let letterPath = /databases/$(database)/documents/couples/$(coupleId)/items/$(letterId);
        let newLetter = existsAfter(letterPath) ? getAfter(letterPath).data : {};
        let oldLetter = exists(letterPath) ? get(letterPath).data : {};
        let matchesNewLetter = newLetter.get('type', '') == 'letter'
          && newLetter.get('status', '') == 'Scheduled'
          && newLetter.get('author', '') == data.author
          && newLetter.get('recipient', '') == data.recipient
          && newLetter.get('deliverDate', null) == data.deliverDate
          && data.author == request.auth.uid;
        let matchesLegacyMigration = oldLetter.get('type', '') == 'letter'
          && oldLetter.get('status', '') == 'Scheduled'
          && oldLetter.get('body', '') is string
          && oldLetter.get('body', '') == data.body
          && oldLetter.get('author', '') == data.author
          && (oldLetter.get('recipient', '') == data.recipient
            || (data.recipient == 'kebyy' && oldLetter.get('recipient', '') == 'Keby')
            || (data.recipient == 'shazy' && oldLetter.get('recipient', '') == 'Shazy'))
          && (data.author == request.auth.uid
            || (data.recipient == ownNotificationProfileKey()
              && isOwnLetterRecipient(oldLetter.get('recipient', ''))));
        return data.keys().hasAll(['author', 'recipient', 'deliverDate', 'body'])
          && data.keys().hasOnly(['author', 'recipient', 'deliverDate', 'body'])
          && data.recipient in ['kebyy', 'shazy']
          && data.deliverDate is timestamp
          && data.body is string
          && (matchesNewLetter || matchesLegacyMigration);
      }

      allow get: if isCoupleMember()
        && coupleId == 'our-little-world'
        && (resource.data.get('author', '') == request.auth.uid
          || (resource.data.get('recipient', '') == ownNotificationProfileKey()
            && resource.data.get('deliverDate', request.time) <= request.time));
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && isValidContentCreate();
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && resource.data.get('author', '') == request.auth.uid
        && request.resource.data == resource.data;
      allow list, delete: if false;
    }

    match /couples/{coupleId}/notifications/{notificationId} {
      allow read: if isCoupleMember()
        && coupleId == 'our-little-world'
        && (!exists(/databases/$(database)/documents/couples/$(coupleId)/notifications/$(notificationId))
          || resource.data.recipientKey == ownNotificationProfileKey()
          || resource.data.actorKey == ownNotificationProfileKey());
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && isValidNotification(request.resource.data, notificationId);
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && resource.data.recipientKey == ownNotificationProfileKey()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && resource.data.recipientKey == ownNotificationProfileKey();
    }

    match /couples/{coupleId}/diaryPosts/{postId}/comments/{commentId} {
      allow read: if isCoupleMember() && coupleId == 'our-little-world' && diaryPostExists(postId);
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && canCommentOnPost(postId)
        && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && canCommentOnPost(postId)
        && resource.data.get('authorId', '') == request.auth.uid
        && request.resource.data.get('authorId', '') == request.auth.uid;
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && diaryPostExists(postId)
        && (resource.data.get('authorId', '') == request.auth.uid || diaryPostIsDeleting(postId));
    }

    match /couples/{coupleId}/challengeAssignments/{assignmentId} {
      allow read: if isCoupleMember() && coupleId == 'our-little-world';
      allow create, update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && request.resource.data.keys().hasAll(['title', 'description', 'challengeDate', 'status', 'acceptedBy', 'skippedBy', 'completedBy'])
        && request.resource.data.keys().hasOnly(['title', 'description', 'challengeDate', 'status', 'acceptedBy', 'skippedBy', 'completedBy', 'updatedAt', 'completedAt', 'challengeId', 'note', 'photoUrl'])
        && request.resource.data.status in ['upcoming', 'in-progress', 'skipped', 'completed'];
      allow delete: if false;
    }

    match /couples/{coupleId}/settings/profiles {
      allow read: if isCoupleMember() && coupleId == 'our-little-world';
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && request.resource.data.keys().hasOnly(['kebyy', 'shazy', 'updatedAt'])
        && (
          (request.auth.token.email == 'akabeeram@gmail.com'
            && request.resource.data.keys().hasOnly(['kebyy', 'updatedAt']))
          || (request.auth.token.email == 'hizasgallery@gmail.com'
            && request.resource.data.keys().hasOnly(['shazy', 'updatedAt']))
        );
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && request.resource.data.keys().hasOnly(['kebyy', 'shazy', 'updatedAt'])
        && (
          (request.auth.token.email == 'akabeeram@gmail.com'
            && request.resource.data.get('shazy', {}) == resource.data.get('shazy', {}))
          || (request.auth.token.email == 'hizasgallery@gmail.com'
            && request.resource.data.get('kebyy', {}) == resource.data.get('kebyy', {}))
        );
      allow delete: if false;
    }

    function isQuestionCoupleMember(coupleId) {
      return request.auth != null
        && request.auth.token.email in ['akabeeram@gmail.com', 'hizasgallery@gmail.com']
        && coupleId == 'our-little-world';
    }

    function ownQuestionProfileKey() {
      return request.auth.token.email == 'akabeeram@gmail.com' ? 'kebyy' : 'shazy';
    }

    function bothQuestionPartnersAnswered(coupleId, dayKey) {
      return exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(dayKey)/participants/kebyy)
        && exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(dayKey)/participants/shazy);
    }

    match /coupleQuestionBank/{coupleId}/{collectionName}/{documentId} {
      allow read: if isQuestionCoupleMember(coupleId);
      allow create, update: if isQuestionCoupleMember(coupleId)
        && (
          (collectionName == 'questions'
            && request.resource.data.keys().hasOnly(['categoryId', 'category', 'question', 'position'])
            && request.resource.data.question is string
            && request.resource.data.question.size() > 0
            && request.resource.data.question.size() <= 300)
          || (collectionName == 'meta'
            && documentId == 'v1'
            && request.resource.data.keys().hasOnly(['version', 'questionCount', 'seededAt'])
            && request.resource.data.questionCount == 105)
        );
      allow delete: if false;
    }

    match /coupleDailyQuestions/{coupleId}/days/{questionRecordId} {
      allow read: if isQuestionCoupleMember(coupleId);
      allow create: if isQuestionCoupleMember(coupleId)
        && request.resource.data.keys().hasOnly(['id', 'categoryId', 'category', 'question', 'dayKey', 'createdAt'])
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (questionRecordId == request.resource.data.dayKey
          || questionRecordId.matches('^legacy-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+$'))
        && exists(/databases/$(database)/documents/coupleQuestionBank/$(coupleId)/questions/$(request.resource.data.id))
        && request.resource.data.createdAt == request.time;
      allow update: if isQuestionCoupleMember(coupleId)
        && questionRecordId == resource.data.dayKey
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question'])
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 300
        && !exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(questionRecordId)/participants/kebyy)
        && !exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(questionRecordId)/participants/shazy);
      allow delete: if false;

      match /participants/{profileKey} {
        allow read: if isQuestionCoupleMember(coupleId);
        allow create: if isQuestionCoupleMember(coupleId)
          && profileKey == ownQuestionProfileKey()
          && request.resource.data.keys().hasOnly(['profileKey', 'answeredAt'])
          && request.resource.data.profileKey == profileKey
          && request.resource.data.answeredAt is timestamp
          && existsAfter(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(questionRecordId)/answers/$(profileKey));
        allow update, delete: if false;
      }

      match /answers/{profileKey} {
        allow read: if isQuestionCoupleMember(coupleId)
          && (profileKey == ownQuestionProfileKey()
            || bothQuestionPartnersAnswered(coupleId, questionRecordId));
        allow create: if isQuestionCoupleMember(coupleId)
          && profileKey == ownQuestionProfileKey()
          && request.resource.data.keys().hasOnly(['profileKey', 'answer', 'answeredAt'])
          && request.resource.data.profileKey == profileKey
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 1200
          && request.resource.data.answeredAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /coupleCustomQuestions/{coupleId}/questions/{questionId} {
      allow read: if isQuestionCoupleMember(coupleId);
      allow create: if isQuestionCoupleMember(coupleId)
        && request.resource.data.keys().hasAll(['text', 'askedBy', 'askedTo', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'askedBy', 'askedTo', 'status', 'createdAt', 'askedByName'])
        && request.resource.data.askedBy == ownQuestionProfileKey()
        && request.resource.data.askedTo != ownQuestionProfileKey()
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      allow update: if isQuestionCoupleMember(coupleId)
        && resource.data.status == 'pending'
        && request.resource.data.askedTo == ownQuestionProfileKey()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt', 'status'])
        && request.resource.data.status == 'answered'
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 1200
        && request.resource.data.answeredAt is timestamp;
      allow delete: if isQuestionCoupleMember(coupleId)
        && resource.data.status == 'pending'
        && resource.data.askedBy == ownQuestionProfileKey();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoupleMember() {
      return request.auth != null && request.auth.token.email in [
        'akabeeram@gmail.com',
        'hizasgallery@gmail.com'
      ];
    }

    function isOwnAuthorId(authorId) {
      return authorId == request.auth.uid
        || (request.auth.token.email == 'akabeeram@gmail.com' && authorId == 'profile-one')
        || (request.auth.token.email == 'hizasgallery@gmail.com' && authorId == 'profile-two');
    }

    function ownsAuthoredFields(data) {
      return data.get('author', request.auth.uid) == request.auth.uid
        && isOwnAuthorId(data.get('authorId', request.auth.uid));
    }

    function ownsDiaryPost(collectionName, data) {
      return collectionName != 'diaryPosts'
        || (data.keys().hasAll(['authorId']) && isOwnAuthorId(data.authorId));
    }

    function isOwnLetterRecipient(recipient) {
      return (request.auth.token.email == 'akabeeram@gmail.com' && recipient == 'kebyy')
        || (request.auth.token.email == 'hizasgallery@gmail.com' && recipient == 'shazy');
    }

    function isLegacyScheduledLetterBodyMigration() {
      return resource.data.get('type', '') == 'letter'
        && resource.data.get('status', '') == 'Scheduled'
        && resource.data.keys().hasAny(['body'])
        && resource.data.get('author', '') != request.auth.uid
        && isOwnLetterRecipient(resource.data.get('recipient', ''))
        && !request.resource.data.keys().hasAny(['body'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body']);
    }

    function canCommentOnPost(postId) {
      return exists(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId))
        && !get(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId)).data.get('deleting', false);
    }

    function diaryPostExists(postId) {
      return exists(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId));
    }

    function diaryPostIsDeleting(postId) {
      let post = get(/databases/$(database)/documents/couples/our-little-world/diaryPosts/$(postId)).data;
      return post.get('deleting', false) && isOwnAuthorId(post.get('authorId', ''));
    }

    match /couples/{coupleId}/{collectionName}/{documentId} {
      allow read: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'scheduledLetterContents'
        && (resource.data.get('type', '') != 'answer'
          || resource.data.get('author', '') == request.auth.uid);
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && request.resource.data.get('type', '') != 'answer'
        && ownsAuthoredFields(request.resource.data)
        && ownsDiaryPost(collectionName, request.resource.data);
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && resource.data.get('type', '') != 'answer'
        && (
          (ownsAuthoredFields(resource.data)
            && ownsAuthoredFields(request.resource.data)
            && ownsDiaryPost(collectionName, request.resource.data))
          || (collectionName == 'items' && isLegacyScheduledLetterBodyMigration())
        );
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && collectionName != 'scheduledLetterContents'
        && !(collectionName == 'settings' && documentId == 'profiles')
        && resource.data.get('type', '') != 'answer'
        && ownsAuthoredFields(resource.data)
        && ownsDiaryPost(collectionName, resource.data);
    }

    match /couples/{coupleId}/diaryPosts/{postId}/comments/{commentId} {
      allow read: if isCoupleMember() && coupleId == 'our-little-world' && diaryPostExists(postId);
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && canCommentOnPost(postId)
        && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && canCommentOnPost(postId)
        && resource.data.get('authorId', '') == request.auth.uid
        && request.resource.data.get('authorId', '') == request.auth.uid;
      allow delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && diaryPostExists(postId)
        && (resource.data.get('authorId', '') == request.auth.uid || diaryPostIsDeleting(postId));
    }

    match /couples/{coupleId}/scheduledLetterContents/{letterId} {
      allow read: if isCoupleMember()
        && coupleId == 'our-little-world'
        && (resource.data.author == request.auth.uid
          || (resource.data.deliverDate <= request.time
            && isOwnLetterRecipient(resource.data.recipient)));
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && (request.resource.data.author == request.auth.uid
          || isOwnLetterRecipient(request.resource.data.recipient))
        && request.resource.data.recipient in ['kebyy', 'shazy']
        && request.resource.data.deliverDate is timestamp
        && request.resource.data.body is string
        && request.resource.data.keys().hasOnly(['author', 'recipient', 'deliverDate', 'body']);
      allow update, delete: if isCoupleMember()
        && coupleId == 'our-little-world'
        && resource.data.author == request.auth.uid;
    }

    match /couples/{coupleId}/settings/profiles {
      allow read: if isCoupleMember() && coupleId == 'our-little-world';
      allow create: if isCoupleMember()
        && coupleId == 'our-little-world'
        && request.resource.data.keys().hasOnly(['kebyy', 'shazy', 'updatedAt'])
        && (
          (request.auth.token.email == 'akabeeram@gmail.com'
            && request.resource.data.keys().hasOnly(['kebyy', 'updatedAt']))
          || (request.auth.token.email == 'hizasgallery@gmail.com'
            && request.resource.data.keys().hasOnly(['shazy', 'updatedAt']))
        );
      allow update: if isCoupleMember()
        && coupleId == 'our-little-world'
        && request.resource.data.keys().hasOnly(['kebyy', 'shazy', 'updatedAt'])
        && (
          (request.auth.token.email == 'akabeeram@gmail.com'
            && request.resource.data.get('shazy', {}) == resource.data.get('shazy', {}))
          || (request.auth.token.email == 'hizasgallery@gmail.com'
            && request.resource.data.get('kebyy', {}) == resource.data.get('kebyy', {}))
        );
      allow delete: if false;
    }

    function isQuestionCoupleMember(coupleId) {
      return request.auth != null
        && request.auth.token.email in ['akabeeram@gmail.com', 'hizasgallery@gmail.com']
        && coupleId == 'our-little-world';
    }

    function ownQuestionProfileKey() {
      return request.auth.token.email == 'akabeeram@gmail.com' ? 'kebyy' : 'shazy';
    }

    function bothQuestionPartnersAnswered(coupleId, dayKey) {
      return exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(dayKey)/participants/kebyy)
        && exists(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(dayKey)/participants/shazy);
    }

    match /coupleQuestionBank/{coupleId}/{collectionName}/{documentId} {
      allow read: if isQuestionCoupleMember(coupleId);
      allow create, update: if isQuestionCoupleMember(coupleId)
        && (
          (collectionName == 'questions'
            && request.resource.data.keys().hasOnly(['categoryId', 'category', 'question', 'position'])
            && request.resource.data.question is string
            && request.resource.data.question.size() > 0
            && request.resource.data.question.size() <= 300)
          || (collectionName == 'meta'
            && documentId == 'v1'
            && request.resource.data.keys().hasOnly(['version', 'questionCount', 'seededAt'])
            && request.resource.data.questionCount == 105)
        );
      allow delete: if false;
    }

    match /coupleDailyQuestions/{coupleId}/days/{questionRecordId} {
      allow read: if isQuestionCoupleMember(coupleId);
      allow create: if isQuestionCoupleMember(coupleId)
        && request.resource.data.keys().hasOnly(['id', 'categoryId', 'category', 'question', 'dayKey', 'createdAt'])
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (questionRecordId == request.resource.data.dayKey
          || questionRecordId.matches('^legacy-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+$'))
        && exists(/databases/$(database)/documents/coupleQuestionBank/$(coupleId)/questions/$(request.resource.data.id))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /participants/{profileKey} {
        allow read: if isQuestionCoupleMember(coupleId);
        allow create: if isQuestionCoupleMember(coupleId)
          && profileKey == ownQuestionProfileKey()
          && request.resource.data.keys().hasOnly(['profileKey', 'answeredAt'])
          && request.resource.data.profileKey == profileKey
          && request.resource.data.answeredAt is timestamp
          && existsAfter(/databases/$(database)/documents/coupleDailyQuestions/$(coupleId)/days/$(questionRecordId)/answers/$(profileKey));
        allow update, delete: if false;
      }

      match /answers/{profileKey} {
        allow read: if isQuestionCoupleMember(coupleId)
          && (profileKey == ownQuestionProfileKey() || bothQuestionPartnersAnswered(coupleId, questionRecordId));
        allow create: if isQuestionCoupleMember(coupleId)
          && profileKey == ownQuestionProfileKey()
          && request.resource.data.keys().hasOnly(['profileKey', 'answer', 'answeredAt'])
          && request.resource.data.profileKey == profileKey
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 1200
          && request.resource.data.answeredAt is timestamp;
        allow update, delete: if false;
      }
    }
  }
}

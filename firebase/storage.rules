rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPartner() {
      return request.auth != null
        && request.auth.token.email in ['akabeeram@gmail.com', 'hizasgallery@gmail.com'];
    }
    match /couples/our-little-world/music/{allPaths=**} {
      allow read: if isPartner();
      allow create, update: if isPartner()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isPartner();
    }
    match /couples/our-little-world/love-challenge/{dayKey}/{fileName} {
      allow read: if isPartner();
      allow create, update: if isPartner()
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.dayKey == dayKey
        && request.resource.metadata.profileKey.matches('^(kebyy|shazy)$');
      allow delete: if isPartner() && resource.metadata.ownerUid == request.auth.uid;
    }
  }
}
